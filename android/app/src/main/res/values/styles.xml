<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Launch window theme.

      The stock template parent is `Theme.Light.NoTitleBar`, which forces a white window
      background behind the splash drawable and shows a white flash before the drawable
      paints. This app is dark-only, so both the window and the status/nav bars are set
      to the scaffold colour here.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">#081014</item>
        <item name="android:navigationBarColor">#081014</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Applied once the Flutter engine is up. Matches the app scaffold so there is no
         flash between the native splash and the first Flutter frame. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">#081014</item>
        <item name="android:statusBarColor">#081014</item>
        <item name="android:navigationBarColor">#081014</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
